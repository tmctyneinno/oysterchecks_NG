# Copy to .env and adjust. Every key maps to runtimeConfig in nuxt.config.ts.

# Required in production: 32+ random characters. Seals session cookies and derives the key
# that encrypts MFA secrets at rest. Changing it signs everyone out and invalidates MFA enrolments.
NUXT_SESSION_PASSWORD=

# SQLite file (development). See README "Production" for moving to Postgres.
NUXT_DB_PATH=.data/oysterchecks.db
NUXT_EVIDENCE_DIR=.data/evidence

# MFA is mandatory by spec (§2.3). Only disable for local development.
NUXT_MFA_ENFORCED=true

# Password given to the seeded demo accounts on first boot.
NUXT_SEED_PASSWORD=OysterDemo!2026

# Demo data generator standing in for live connectors. MUST be false in any real deployment.
NUXT_DEMO_SIMULATOR=true

# How often the CCM engine evaluates rules and escalations.
NUXT_CCM_INTERVAL_SECONDS=60
